lazy val millDiscover0         = Discover[this.type]
override lazy val millDiscover = millDiscover0

// Tell mill modules are under modules/
implicit def millModuleBasePath: ModuleCtx.Nested =
  MillCsHelper.moduleCtxWithDiscoverAndEnclosingModule(
    ModuleCtx.makeRoot(
      implicitly,
      implicitly,
      BuildCtx.workspaceRoot / "modules",
      Segments(),
      false,
      implicitly
    ),
    millDiscover0,
    this
  )

/** The Scala 2 macros of the logger of [[Kernel]], that have to be compiled before it.
  *
  * Not published on its own - [[Kernel]] ships its classes and sources alongside its own.
  */
trait LoggerScala2Macros extends Cross.Module[String] with AlmondUnpublishedModule
    with AlmondJvmTarget {
  def crossScalaVersion = crossValue
  def mvnDeps = Task {
    Seq(Deps.scalaReflect(scalaVersion()))
  }
}

/** The API user code is written against - `almond.interpreter.api` for the kernels, and
  * `almond.api` / `almond.display` / `almond.input` for the users of the Scala kernel.
  */
trait Api extends Cross.Module[String] with AlmondModule with AlmondMima {
  def crossScalaVersion = crossValue
  def mvnDeps = Seq(
    Deps.jvmRepr
  )

  def mimaBinaryIssueFilters = Seq(
    // abstract classes not meant to be implemented by users
    ProblemFilter.exclude[ReversedMissingMethodProblem](
      "almond.interpreter.api.OutputHandler.*"
    ),
    ProblemFilter.exclude[ReversedMissingMethodProblem]("almond.api.JupyterApi.*")
  )

  // Our classes used to be published as two modules, interpreter-api and jupyter-api -
  // keep checking them against those, our own name has no release to be compared with yet.
  def mimaPreviousArtifacts = Task {
    val versions = mimaPreviousVersions().distinct
    mill.api.Result.Success(
      for {
        name    <- Seq("interpreter-api", "jupyter-api")
        version <- versions
      } yield mvn"${pomSettings().organization}:$name${artifactSuffix()}:$version"
    )
  }
}

trait Kernel extends Cross.Module[String] with AlmondModule {
  def crossScalaVersion = crossValue

  /** Our Scala 2 macros, that only exist for the Scala 2 binary versions */
  private def macrosModuleOpt: Option[LoggerScala2Macros] =
    if (isScala3(crossScalaVersion)) None
    else Some(shared.`logger-scala2-macros`())

  def moduleDeps = Seq(
    api()
  )
  def compileModuleDeps = super.compileModuleDeps ++ macrosModuleOpt.toSeq

  // The macros are only needed at compile time, and are of no use on their own - rather than
  // publishing them separately, we add their classes to our local compile class path, which
  // puts them both in our JAR and on the compile class path of the modules depending on us.
  def localCompileClasspath = Task {
    super.localCompileClasspath() ++
      Task.traverse(macrosModuleOpt.toSeq)(_.compile)().map(_.classes)
  }
  // Ship the sources of the macros alongside ours too, for the classes above not to miss theirs
  def sourceJar = Task {
    val macroSources = Task.traverse(macrosModuleOpt.toSeq)(_.allSources)().flatten
    PathRef(
      mill.util.Jvm.createJar(
        Task.dest / "out.jar",
        (allSources() ++ macroSources ++ resources() ++ compileResources())
          .map(_.path)
          .filter(os.exists),
        manifest()
      )
    )
  }

  def compileMvnDeps = Seq(
    Deps.jsoniterScalaMacros
  )
  def mvnDeps = Task {
    val sv = scalaVersion()
    val scalaReflect =
      if (sv.startsWith("2.")) Seq(Deps.scalaReflect(sv))
      else Seq(mvn"org.scala-lang:scala3-library_3:$sv")
    scalaReflect ++ Seq(
      Deps.caseAppAnnotations,
      Deps.collectionCompat,
      Deps.coursierApi,
      Deps.fansi,
      Deps.fs2,
      Deps.jeromq,
      Deps.jsoniterScalaCore,
      Deps.scalatags,
      Deps.slf4jNop
    )
  }
  object test extends CrossSbtModuleTests with AlmondTestModule {
    def moduleDeps = super.moduleDeps ++ Seq(
      shared.`test-kit`()
    )
  }
}

// Only used by the tests of the echo kernel, that we only build for Scala 3
trait Test extends SbtModule with AlmondRepositories with AlmondScalacOptions {
  private def sv   = ScalaVersions.scala3Compat
  def scalaVersion = sv
  def moduleDeps = Seq(
    api(sv)
  )
}

trait ScalaKernelApi extends Cross.Module[String] with AlmondModule with DependencyListResource
    with ExternalSources with PropertyFile with AlmondMima {
  def crossScalaVersion = crossValue
  def moduleDeps = Seq(
    api()
  )
  def mvnDeps = Seq(
    Deps.ammoniteCompiler.exclude(("org.slf4j", "slf4j-api")),
    Deps.ammoniteReplApi.exclude(("org.slf4j", "slf4j-api")),
    Deps.scalaCompiler(crossScalaVersion),
    Deps.jvmRepr,
    Deps.coursierApi.exclude(("org.slf4j", "slf4j-api")),
    Deps.collectionCompat
  )

  def resolvedMvnDeps = Task {
    // Ensure we don't depend on slf4j-api
    // As no logger implem would be loaded alongside it by default, slf4j would fail to initialize,
    // complain in stderr, and default to NOP logging.
    val value = super.resolvedMvnDeps()
    val jarNames = value
      .map(_.path.last)
      .filter(_.endsWith(".jar"))
      .map(_.stripSuffix(".jar"))
    val slf4jJars = jarNames.filter(_.startsWith("slf4j-"))
    if (slf4jJars.nonEmpty)
      sys.error(s"Found slf4j JARs: ${slf4jJars.mkString(", ")}")
    value
  }

  // We used to be published for each full Scala version - the artifacts we publish now
  // (scala-kernel-api_2.13 rather than scala-kernel-api_2.13.18, …) have no release to be
  // compared with yet.
  def mimaPreviousVersions = Task(Seq.empty[String])

  def propertyFilePath = "almond/almond.properties"
  def propertyExtra = Task {
    Seq(
      "default-scalafmt-version"        -> Deps.scalafmtDynamic.dep.versionConstraint.asString,
      "default-scalafmt-version-java-8" -> Versions.scalafmtJava8,
      "scala-version"                   -> crossScalaVersion
    )
  }

  // Getting transient errors upon incremental compilation without this
  def resources = super.resources
}

trait ScalaInterpreter extends Cross.Module[String] with AlmondModule {
  def crossScalaVersion = crossValue
  def moduleDeps = Seq(
    shared.kernel(),
    scala.`kernel-helpers`(),
    scala.`scala-kernel-api`()
  )
  def mvnDeps = Task {
    val metabrowse =
      if (crossScalaVersion.startsWith("2."))
        Seq(
          // The scalameta versions of mtags (Metals) and Ammonite may clash here :\
          Deps.mtags
        )
      else
        Seq.empty
    metabrowse ++ Seq(
      Deps.coursierApi,
      Deps.coursierPaths,
      // for dependency.ModuleMatcher, to match automatic dependencies with globs
      Deps.dependency,
      Deps.dependencyInterface,
      Deps.directiveHandler,
      Deps.jansi,
      Deps.ammoniteCompiler.exclude(("net.java.dev.jna", "jna")),
      Deps.ammoniteRepl.exclude(("net.java.dev.jna", "jna")),
      Deps.scalaCompiler(crossScalaVersion)
    )
  }
  def compileMvnDeps = Seq(
    Deps.jsoniterScalaMacros
  )
  def scalacOptions = super.scalacOptions() ++ {
    val scala213Options =
      if (scalaVersion().startsWith("2.13.")) Seq("-Ymacro-annotations")
      else Nil
    scala213Options
  }
  object test extends Cross[ScalaInterpreterTests](ScalaVersions.fullVersionsFor(crossValue))
  trait ScalaInterpreterTests extends CrossSbtModuleTests with AlmondFullCrossTests {
    def scalaVersionSpecificModule = shared.`test-kit`(crossValue)
    // else the test sources would be looked for under src/<the cross value>
    override def testModuleName = "test"
    def moduleDeps = {
      val rx =
        if (crossValue.startsWith("2.12.")) Seq(scala.`almond-rx`(ScalaVersions.binary(crossValue)))
        else Nil
      super.moduleDeps ++ rx ++ Seq(
        shared.`test-kit`(crossValue),
        shared.kernel(ScalaVersions.binary(crossValue)).test,
        scala.`test-definitions`(crossValue)
      )
    }
    def mvnDeps = super.mvnDeps() ++ Seq(
      Deps.caseApp
    )
    // Getting weird errors with test parallelism on CI when running all tests,
    // but getting weird ones locally with test parallelism disabled
    def testParallelism = System.getenv("CI") == null
  }
}

trait ScalaKernel extends Cross.Module[String] with AlmondModule with ExternalSources
    with BootstrapLauncher {
  def crossScalaVersion = crossValue
  def moduleDeps = Seq(
    shared.kernel(),
    scala.`scala-interpreter`()
  )
  def mvnDeps = Seq(
    Deps.caseApp,
    Deps.classPathUtil,
    // for coursier.Resolve, only in the top-level coursier module
    Deps.coursier.withDottyCompat(crossScalaVersion),
    Deps.coursierApi,
    Deps.dependency,
    Deps.dependencyInterface,
    Deps.scalafmtDynamic.withDottyCompat(crossScalaVersion)
  )
  object test extends Cross[ScalaKernelTests](ScalaVersions.fullVersionsFor(crossValue))
  trait ScalaKernelTests extends CrossSbtModuleTests with AlmondFullCrossTests {
    def scalaVersionSpecificModule = shared.`test-kit`(crossValue)
    // else the test sources would be looked for under src/<the cross value>
    override def testModuleName = "test"
    def moduleDeps = super.moduleDeps ++ Seq(
      scala.`scala-interpreter`(ScalaVersions.binary(crossValue)).test(crossValue)
    )
  }

  def resolvedMvnDeps = Task {
    // Ensure we stay on slf4j 1.x
    // Kind of unnecessary now that scala-kernel-api doesn't bring slf4j-api any more,
    // but keeping that just in case…
    val value = super.resolvedMvnDeps()
    val jarNames = value
      .map(_.path.last)
      .filter(_.endsWith(".jar"))
      .map(_.stripSuffix(".jar"))
    val slf4jJars = jarNames.filter(_.startsWith("slf4j-"))
    assert(slf4jJars.nonEmpty, "No slf4j JARs found")
    val wrongSlf4jVersionJars = slf4jJars.filter { name =>
      val version = name.split('-').dropWhile(_.head.isLetter).mkString("-")
      !version.startsWith("1.")
    }
    if (wrongSlf4jVersionJars.nonEmpty)
      sys.error(s"Found some slf4j non-1.x JARs: ${wrongSlf4jVersionJars.mkString(", ")}")

    value
  }

  def runClasspath =
    super.runClasspath() ++
      transitiveSources() ++
      externalSources()
  def launcherClassPath =
    transitiveJars() ++
      unmanagedClasspath() ++
      resolvedRunMvnDeps() ++
      transitiveSourceJars() ++
      externalSources()
  def launcherSharedClassPath = {
    val mod: AlmondModule & ExternalSources = scala.`scala-kernel-api`()
    mod.transitiveJars() ++
      mod.unmanagedClasspath() ++
      mod.resolvedRunMvnDeps() ++
      mod.transitiveSourceJars() ++
      mod.externalSources()
  }

  def manifest = Task {
    import java.util.jar.Attributes.Name
    val ver = publishVersion()
    super.manifest().add(
      Name.IMPLEMENTATION_TITLE.toString   -> "scala-kernel",
      Name.IMPLEMENTATION_VERSION.toString -> ver,
      Name.SPECIFICATION_VENDOR.toString   -> "sh.almond",
      Name.SPECIFICATION_TITLE.toString    -> "scala-kernel",
      "Implementation-Vendor-Id"           -> "sh.almond",
      "Specification-Version"              -> ver,
      Name.IMPLEMENTATION_VENDOR.toString  -> "sh.almond"
    )
  }
  def mainClass = Some("almond.ScalaKernel")

  /** Launchers of this kernel, running one specific full Scala version.
    *
    * We are built with the oldest full Scala version of our binary Scala version. These resolve our
    * dependencies with one of the Scala versions we support instead, so that the kernel runs
    *   - and compiles the code users type - with that one rather than with the one we are built
    *     with.
    */
  object launchers extends Cross[Launchers](ScalaVersions.fullVersionsFor(crossValue))
  trait Launchers  extends Cross.Module[String] with AlmondCrossSbtModule with AlmondRepositories
      with TransitiveSources with ExternalSources with BootstrapLauncher
      with AlmondForcedScalaVersion {
    def crossScalaVersion = crossValue
    def moduleDeps        = Seq(ScalaKernel.this)
    def mvnDeps           = Seq(Deps.scalaCompiler(crossValue))
    def mainClass         = ScalaKernel.this.mainClass()

    /** The kernel API, whose dependencies go to the shared class loader, resolved like us. */
    object api extends AlmondCrossSbtModule with AlmondRepositories with ExternalSources
        with AlmondForcedScalaVersion {
      def crossValue        = Launchers.this.crossValue
      def crossScalaVersion = crossValue
      def moduleDeps        = Seq(scala.`scala-kernel-api`(ScalaVersions.binary(crossValue)))
      def mvnDeps           = Seq(Deps.scalaCompiler(crossValue))
    }

    def launcherClassPath = {
      val mod = ScalaKernel.this
      mod.transitiveJars() ++
        mod.unmanagedClasspath() ++
        resolvedRunMvnDeps() ++
        mod.transitiveSourceJars() ++
        externalSources()
    }
    def launcherSharedClassPath = {
      val mod: AlmondModule & ExternalSources = scala.`scala-kernel-api`(
        ScalaVersions.binary(crossValue)
      )
      mod.transitiveJars() ++
        mod.unmanagedClasspath() ++
        api.resolvedRunMvnDeps() ++
        mod.transitiveSourceJars() ++
        api.externalSources()
    }
  }

  def generatedSources: T[Seq[PathRef]] = Task {
    val constantsFileContent =
      s"""package almond.internal
         |
         |object Constants {
         |  def almondVersion = "${publishVersion()}"
         |  def actualScalaVersion = "${scalaVersion()}"
         |}
         |""".stripMargin
    os.write(Task.dest / "Constants.scala", constantsFileContent)
    Seq(PathRef(Task.dest)) ++ super.generatedSources()
  }
}

